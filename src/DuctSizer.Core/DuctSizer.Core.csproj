<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Compiler and default .NET analyzer warnings fail the build so new problems cannot accumulate. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DuctSizer.Core</RootNamespace>
    <AssemblyName>DuctSizer.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\TitusTbd80D.csv" />
    <EmbeddedResource Include="Data\Titus350R.csv" />
    <EmbeddedResource Include="Fonts\Nunito-Regular.ttf" />
    <EmbeddedResource Include="Fonts\Nunito-Bold.ttf" />
    <EmbeddedResource Include="Fonts\Nunito-Italic.ttf" />
    <EmbeddedResource Include="Fonts\Nunito-ExtraBold.ttf" />
    <EmbeddedResource Include="Fonts\FanWorksSymbols.ttf" />
    <EmbeddedResource Include="Brand\mark-rgb.jpg" />
    <EmbeddedResource Include="Brand\mark-alpha.z" />
    <EmbeddedResource Include="Brand\wordmark.path" />
  </ItemGroup>
</Project>
