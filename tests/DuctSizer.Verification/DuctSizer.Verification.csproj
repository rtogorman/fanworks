<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Compiler and default .NET analyzer warnings fail the build so new problems cannot accumulate. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DuctSizer.Core\DuctSizer.Core.csproj" />
  </ItemGroup>
</Project>
